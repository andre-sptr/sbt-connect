generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                 Int      @id @default(autoincrement())
  name               String
  groupIds           String
  spreadsheetUrl     String
  gid                String
  cellRange          String
  caption            String
  cronExpression     String
  timezone           String   @default("Asia/Jakarta")
  enabled            Boolean  @default(true)
  maxRetries         Int      @default(0)
  retryDelayMinutes  Int      @default(5)
  publicToken        String?  @unique
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  runs               Run[]
  logs               Log[]
  telegramRequests   TelegramRequest[]
}

model TelegramRequest {
  id                Int      @id @default(autoincrement())
  telegramUpdateId  String?
  telegramMessageId String?
  chatId            String
  chatType          String?
  chatTitle         String?
  userId            String?
  username          String?
  firstName         String?
  lastName          String?
  picName           String?
  picNik            String?
  picUnit           String?
  projectName       String?
  groupIds          String?   // JSON: resolved WA group IDs ["120363xxx@g.us", ...]
  groupNames        String?   // JSON: original group names user typed ["Sales Jawa", ...]
  spreadsheetUrl    String?
  gid               String?
  cellRange         String?
  caption           String?
  cronExpression    String?
  rawMessage        String
  status            String   @default("pending")
  validationError   String?
  rejectionReason   String?
  reviewedAt        DateTime?
  adminMessageId    String?  // Telegram message_id notif di chat admin (untuk edit inline keyboard)
  projectId         Int?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@index([projectId])
}

model TelegramConversationState {
  id         Int      @id @default(autoincrement())
  chatId     String   @unique
  step       String   // "awaiting_group_selection" | "awaiting_invite"
  payload    String   // JSON: state data
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Run {
  id             Int       @id @default(autoincrement())
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action         String
  status         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  errorSummary   String?
  screenshotPath String?
  thumbnailPath  String?
  logs           Log[]
}

model Log {
  id        Int      @id @default(autoincrement())
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     Int?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())
}

model CachedGroup {
  id          Int      @id @default(autoincrement())
  remote      String   @unique
  name        String
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PythonJob {
  id               Int            @id @default(autoincrement())
  name             String
  originalFilename String
  storedPath       String
  cronExpression   String
  timezone         String         @default("Asia/Jakarta")
  enabled          Boolean        @default(true)
  timeoutSeconds   Int            @default(600)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  runs             PythonRun[]
  logs             PythonJobLog[]
}

model PythonRun {
  id            Int            @id @default(autoincrement())
  pythonJobId   Int
  pythonJob     PythonJob      @relation(fields: [pythonJobId], references: [id], onDelete: Cascade)
  source        String
  status        String
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  exitCode      Int?
  timedOut      Boolean        @default(false)
  errorSummary  String?
  logs          PythonJobLog[]
}

model PythonJobLog {
  id          Int        @id @default(autoincrement())
  pythonJobId Int
  pythonJob   PythonJob  @relation(fields: [pythonJobId], references: [id], onDelete: Cascade)
  pythonRunId Int?
  pythonRun   PythonRun? @relation(fields: [pythonRunId], references: [id], onDelete: Cascade)
  level       String     @default("info")
  stream      String     @default("status")
  message     String
  createdAt   DateTime   @default(now())
}
