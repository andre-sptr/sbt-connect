generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  passwordHash   String
  role           String    @default("user")  // "admin" | "user"
  isActive       Boolean   @default(true)
  telegramChatId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]
}

model UserRequest {
  id                Int       @id @default(autoincrement())
  chatId            String    @unique
  telegramUserId    String?
  username          String?
  firstName         String?
  lastName          String?
  requestedUsername String
  status            String    @default("pending")  // "pending" | "approved" | "rejected"
  adminMessageId    String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Project {
  id                 Int      @id @default(autoincrement())
  name               String
  groupIds           String
  spreadsheetUrl     String
  gid                String
  cellRange          String
  caption            String
  cronExpression     String
  timezone           String   @default("Asia/Jakarta")
  enabled            Boolean  @default(true)
  maxRetries         Int      @default(0)
  retryDelayMinutes  Int      @default(5)
  publicToken        String?  @unique
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdByUserId    Int?
  createdBy          User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs               Run[]
  logs               Log[]
}


model Run {
  id             Int       @id @default(autoincrement())
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action         String
  status         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  errorSummary   String?
  screenshotPath String?
  thumbnailPath  String?
  logs           Log[]
}

model Log {
  id        Int      @id @default(autoincrement())
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     Int?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String   @default("info")
  message   String
  createdAt DateTime @default(now())
}

model CachedGroup {
  id          Int      @id @default(autoincrement())
  remote      String   @unique
  name        String
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PythonJob {
  id               Int            @id @default(autoincrement())
  name             String
  originalFilename String
  storedPath       String
  cronExpression   String
  timezone         String         @default("Asia/Jakarta")
  enabled          Boolean        @default(true)
  timeoutSeconds   Int            @default(600)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  runs             PythonRun[]
  logs             PythonJobLog[]
}

model PythonRun {
  id            Int            @id @default(autoincrement())
  pythonJobId   Int
  pythonJob     PythonJob      @relation(fields: [pythonJobId], references: [id], onDelete: Cascade)
  source        String
  status        String
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  exitCode      Int?
  timedOut      Boolean        @default(false)
  errorSummary  String?
  logs          PythonJobLog[]
}

model PythonJobLog {
  id          Int        @id @default(autoincrement())
  pythonJobId Int
  pythonJob   PythonJob  @relation(fields: [pythonJobId], references: [id], onDelete: Cascade)
  pythonRunId Int?
  pythonRun   PythonRun? @relation(fields: [pythonRunId], references: [id], onDelete: Cascade)
  level       String     @default("info")
  stream      String     @default("status")
  message     String
  createdAt   DateTime   @default(now())
}
