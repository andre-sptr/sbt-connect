# Database
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
DATABASE_URL="file:./dashboard-bot.db"
TIMEZONE="Asia/Jakarta"

# Auth dashboard
# AUTH_SECRET: generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-32"
# Dipakai oleh: npx prisma db seed (buat/update akun admin pertama)
# Setelah seed, akun bisa dikelola lewat dashboard > Admin > Kelola User
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# WAHA (WhatsApp)
WAHA_URL="https://waha.domain-anda.com"
WAHA_SESSION="default"
WAHA_API_KEY="ganti-dengan-api-key-waha"
WAHA_WEBHOOK_SECRET="ganti-dengan-secret-webhook-waha"

# Telegram bot
TELEGRAM_BOT_TOKEN="token-dari-botfather"
TELEGRAM_WEBHOOK_SECRET="ganti-dengan-secret-panjang-acak"
# Opsional: username bot tanpa @, dipakai untuk referensi di help
TELEGRAM_BOT_USERNAME="nama_bot"
# Opsional: chat ID admin Telegram — untuk notifikasi approval pendaftaran akun
TELEGRAM_ADMIN_CHAT_ID=""

# Role-Based Access Control WhatsApp bot
# Super admin: akses penuh (semua command termasuk !edit, !delete, !project)
# Operator: akses terbatas (!status, !run, !laporan, !info, !history, !schedule, !pause, !resume, !screenshot, !retry)
SUPER_ADMIN_GROUP_IDS="120363xxxxxxxx@g.us,120363yyyyyyyy@g.us"
OPERATOR_GROUP_IDS="120363zzzzzzzz@g.us"
# Legacy — masih didukung, diperlakukan sebagai super admin
ADMIN_GROUP_ID=""

# Opsional: path executable Python untuk Python Jobs
# Kosongkan untuk otomatis memakai .venv jika ada, fallback ke python/python3 sistem
PYTHON_EXECUTABLE=""
